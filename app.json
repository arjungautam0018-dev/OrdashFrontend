{
  "expo": {
    "name": "Ordash",
    "slug": "my-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.myapp.preview"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon2.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ordash to access your camera to scan table QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ordash to access your photos.",
          "savePhotosPermission": "Allow Ordash to save the QR code to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-updates",
      "expo-status-bar"
    ],
    "updates": {
      "url": "https://u.expo.dev/86b50e7f-9497-4be1-b048-0b8239c838be"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "86b50e7f-9497-4be1-b048-0b8239c838be"
      }
    },
    "owner": "arjungautam0018"
  }
}
